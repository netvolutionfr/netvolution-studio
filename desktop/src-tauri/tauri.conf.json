{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Netvolution Studio",
  "version": "0.1.0",
  "identifier": "fr.netvolution.studio",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Netvolution Studio",
        "width": 1440,
        "height": 900
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/app/": "app/"
    },
    "publisher": "Netvolution",
    "copyright": "Apache-2.0",
    "shortDescription": "Visual editor for static websites",
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "12.0"
    }
  }
}
