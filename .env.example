# AI assistant of the Studio (ADR-0014). Copy to `.env` (never versioned); read by the server
# only: keys are never sent to the browser nor written into exports.

# Production server: public name(s) of the Studio behind the reverse proxy, comma-separated.
# Only these and localhost are accepted in the Host header (DNS rebinding).
# NS_ALLOWED_HOSTS=studio.example.org

# anthropic | openai | simulated — empty: assistant disabled.
NS_AI_PROVIDER=

# Anthropic (Messages API). Default model: claude-opus-5-5.
ANTHROPIC_API_KEY=
# NS_AI_MODEL=claude-opus-5-5

# OpenAI-compatible endpoint (OpenAI, Mistral, Ollama, LM Studio…): NS_AI_MODEL required.
# NS_AI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# NS_AI_MODEL=

# Limits (default values).
# NS_AI_MAX_TOKENS=4000
# NS_AI_REQUESTS_PER_MINUTE=10
# NS_AI_DAILY_TOKENS=200000
