# Assistant IA du Studio (ADR-0014). Copier en `.env` (jamais versionné) ; lu par le serveur de
# développement uniquement : les clés ne sont envoyées ni au navigateur ni dans les exports.

# anthropic | openai | simulated — vide : assistant désactivé.
NS_AI_PROVIDER=

# Anthropic (API Messages). Modèle par défaut : claude-opus-5-5.
ANTHROPIC_API_KEY=
# NS_AI_MODEL=claude-opus-5-5

# Point d'accès compatible OpenAI (OpenAI, Mistral, Ollama, LM Studio…) : NS_AI_MODEL requis.
# NS_AI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# NS_AI_MODEL=

# Limites (valeurs par défaut).
# NS_AI_MAX_TOKENS=4000
# NS_AI_REQUESTS_PER_MINUTE=10
# NS_AI_DAILY_TOKENS=200000
